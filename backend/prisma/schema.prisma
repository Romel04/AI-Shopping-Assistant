datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  category    String
  price       Float
  stock       Int
  imageUrl    String?
  dateAdded   DateTime @default(now())
}
